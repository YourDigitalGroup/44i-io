// Empty orders are blocked: no service ticked -> Next from the services step is refused with a message pointing at the Companion, and Submit refuses too
// (nothing saved). With a service ticked everything is unchanged. Real form code in Chromium with a fake Supabase/Trello/email.
const { check, done, ROOT } = require('./lib');
let chromium; try { ({ chromium } = require('playwright')); } catch (e) { console.log('SKIPPED (playwright is not installed)'); process.exit(0); }
const SB = 'https://emydtkhnespbxraiijkx.supabase.co';
const G = 'a0000000-0000-4000-8000-000000000001', CL = 'c0000000-0000-4000-8000-000000000002', ORD = 'd0000000-0000-4000-8000-000000000003';
const SERVICES = [{ id: 'w-flat', label: 'Website Flat Thing', section: 'web', active: true, sort_order: 1, billing_type: 'one_time', pricing_mode: 'flat', default_price: 175 }];
(async () => {
  let browser; try { browser = await chromium.launch(); } catch (e) { try { browser = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium' }); } catch (e2) { console.log('SKIPPED (no browser)'); process.exit(0); } }
  try {
    const open = async () => {
      const pg = await browser.newPage({ viewport: { width: 1200, height: 900 } }); const seen = { orders: [], errs: [] }; pg.on('pageerror', e => seen.errs.push(e.message));
      await pg.route('**/*', async r => { const u = r.request().url(), m = r.request().method(); if (u.startsWith('file:')) return r.continue(); if (!u.startsWith(SB)) return r.abort(); let body = '[]';
        if (u.includes('/rest/v1/services')) body = JSON.stringify(SERVICES); else if (u.includes('/rest/v1/sections')) body = JSON.stringify([{ id: 'web', label: 'Website', sort_order: 1, active: true }]);
        else if (u.includes('/rpc/get_group_for_embed_key')) body = JSON.stringify([{ id: G, name: 'Test Group', active: true, io_slug: 't', am_name: 'Carol', am_email: 'c@x.com' }]);
        else if (u.includes('hosting_proration_settings')) body = JSON.stringify([{ page_type: '1p', days: 3, label: '1 page' }]); else if (u.includes('/rest/v1/intake_forms')) body = JSON.stringify([{ id: 'x', title: 'X', definition: {} }]);
        else if (u.includes('/rpc/find_or_create_client')) body = JSON.stringify({ id: CL, trello_list_id: null }); else if (u.includes('/rpc/')) body = '{}';
        else if (u.includes('/rest/v1/orders') && m === 'POST') { seen.orders.push(JSON.parse(r.request().postData() || '{}')); body = JSON.stringify([{ id: ORD }]); }
        await r.fulfill({ status: 200, contentType: 'application/json', headers: { 'access-control-allow-origin': '*' }, body }); });
      await pg.goto('file://' + ROOT + '/index.html?preview=1&t=abc123'); await pg.waitForSelector('tr[data-id="w-flat"]', { state: 'attached', timeout: 15000 }); pg.setDefaultTimeout(10000);
      return { pg, seen };
    };
    const fillAndRun = (pg, tick, action) => pg.evaluate(async ({ tick, action }) => {
      window.generateIoPdfBlob = async () => ({ base64: 'AAAA', fileName: 'io.pdf' });
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
      set('biz-name', 'Smoke Test Co'); set('contact-name', 'Pat'); set('contact-phone', '555-1212'); set('contact-email', 'pat@x.test'); set('website-url', 'https://x.test'); set('city', 'Des Moines'); set('biz-type', 'Retail');
      set('ae-name', 'Ann AE'); set('ae-email', 'ann@x.test'); set('io-date', '2026-10-15'); set('campaign-start', '2027-01-01'); set('auth-name', 'Pat Client'); set('auth-title', 'Owner');
      ['agree-terms', 'agree-ip', 'agree-pricing'].forEach(id => { const el = document.getElementById(id); if (el) el.checked = true; });
      window.hasSignature = () => true; window.getSignatureData = () => 'data:image/png;base64,AAAA';
      if (tick) { const cb = document.querySelector('tr[data-id="w-flat"] input[type=checkbox]'); cb.checked = true; toggle(cb, 'w-flat'); selected['w-flat'].start_date = '2027-01-01'; }
      const toasts = []; const real = showToast; window.showToast = (m, t) => { toasts.push(m); real(m, t); };
      if (action === 'next') goStep(3); else await submitIO();
      return { step: currentStep, toasts, success: document.getElementById('page-success').style.display === 'block' }; }, { tick, action });
    let { pg, seen } = await open(); let r = await fillAndRun(pg, false, 'next');
    check('no service ticked: Next does NOT reach step 3 and the message points at the Companion', [r.step === 3, r.toasts.some(m => /Select at least one service\. To change or cancel an existing service, use the Companion/.test(m))], [false, true]); await pg.close();
    ({ pg, seen } = await open()); r = await fillAndRun(pg, false, 'submit');
    check('no service ticked: Submit refuses too (the safety net): nothing is saved, no success screen, same message', [seen.orders.length, r.success, r.toasts.some(m => /Select at least one service/.test(m))], [0, false, true]); await pg.close();
    ({ pg, seen } = await open()); r = await fillAndRun(pg, true, 'next');
    check('one service ticked: Next goes through to step 3 as before', r.step, 3);
    r = await pg.evaluate(async () => { await submitIO(); return { success: document.getElementById('page-success').style.display === 'block' }; });
    check('one service ticked: the order saves and the success screen shows as before', [seen.orders.length, r.success], [1, true]); await pg.close();
    check('no page errors', seen.errs, []);
  } finally { await browser.close(); }
  done();
})().catch(e => { console.log('FAIL browser test crashed: ' + e.message); process.exitCode = 1; });
