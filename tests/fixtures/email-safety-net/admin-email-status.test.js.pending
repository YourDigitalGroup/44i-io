// Email safety net (Admin half, 2026-10-16): order email status in the list/detail, the attention rule, and "Resend order email" (right people, team copy rule, records the time).
// Real Admin functions in jsdom with a fake mail service and fake database calls.
const { read, fn, check, done } = require('./lib');
let JSDOM; try { ({ JSDOM } = require('jsdom')); } catch (e) { console.log('SKIPPED (jsdom is not installed)'); process.exit(0); }
const admin = read('admin/index.html'), shared = read('shared.js');
const win = new JSDOM('<body><div id="order-email-line"></div><button id="resend-email-btn"></button></body>', { runScripts: 'outside-only' }).window;
win.eval([fn(shared, 'esc'), ...['adminPgMessage', 'adminOrderTooFreshForRetry', 'adminOrderHasTrelloBoard', 'adminOrderEmailState', 'adminOrderEmailMarkerHtml', 'adminOrderEmailLineHtml', 'adminOrderNeedsAttention', 'adminResolutionRecipients', 'adminResendOrderEmail'].map(n => fn(admin, n)),
  `var ADMIN_RETRY_MIN_AGE_MINUTES = 10, ADMIN_ORDER_CANCEL = {}, PROXY = 'proxy', __toasts = [], __sent = [], __db = [], __sendStatus = 200, __pdfOk = true, currentAdminUser = { name: 'Carol', pw: 'x' };
   var allGroups = [{ id: 'g1', name: 'Grp', io_recipient: 'io1@x.test, io2@x.test', trello_board_id: 'B', brand_color: '#123456' }, { id: 'g2', name: 'NoRecip', io_recipient: '', trello_board_id: 'B' }, { id: 'g3', name: 'TestGrp', io_recipient: 'io3@x.test', trello_board_id: 'B', no_team_copy: true }, { id: 'g4', name: 'QuietTest', io_recipient: '', trello_board_id: 'B', no_team_copy: true }];
   var ALL_AES = [{ group_id: 'g1', name: 'Ann AE', email: 'ann@x.test' }, { group_id: 'g2', name: 'Bob AE', email: 'bob@x.test' }], allOrders = [];
   async function ensureAeRosterLoaded() {} function sbAuthHeaders() { return {}; } function showToast(m, t) { __toasts.push((t || 'ok') + ': ' + m); } function fmtDateTime(d) { return 'DT(' + String(d).slice(0, 10) + ')'; }
   function renderAdminOrders() {} async function generateAdminRevisedIoPdfBlob() { if (!__pdfOk) throw new Error('pdf'); return { base64: 'AAAA', fileName: 'io.pdf' }; }
   async function sb(path, o) { __db.push({ path, body: o && o.body ? JSON.parse(o.body) : null }); if (path.endsWith('admin_get_notification_settings')) return [{ id: 1, always_bcc_recipients: 'team1@x.test, io1@x.test' }]; return null; }
   window.fetch = async (url, o) => { const b = JSON.parse(o.body); __sent.push(b); return { ok: __sendStatus < 400, status: __sendStatus, json: async () => ({}) }; };
   window.confirm = () => true;`].join('\n'));
const old = new Date(Date.now() - 3 * 3600000).toISOString(), fresh = new Date(Date.now() - 2 * 60000).toISOString();
const o = (extra) => ({ id: 'o1', group_id: 'g1', ae_name: 'Ann AE', _client_name: 'Acme', io_number: 'IO-1', created_at: old, trello_synced: true, email_sent_at: null, ...extra });
const st = x => win.adminOrderEmailState(JSON.parse(JSON.stringify(x))).state;
(async () => {
  check('state: sent when there is a timestamp; unsent when empty and the group has IO recipients', [st(o({ email_sent_at: old })), st(o())], ['sent', 'unsent']);
  check('state: a group with NO IO recipients is still flagged (the email goes to the AE and the team list); only a team-copy-off group with no recipients and no AE email is "none"; under 10 minutes is "pending"; no column shows nothing', [st(o({ group_id: 'g2' })), st(o({ group_id: 'g4', ae_name: 'Nobody' })), st(o({ group_id: 'g4', ae_name: 'Nobody', created_at: fresh })), st(o({ created_at: fresh })), (() => { const x = o(); delete x.email_sent_at; return st(x); })()], ['unsent', 'none', 'none', 'pending', 'unknown']);
  check('list marker: ✉ for sent, ✉⚠ for unsent, nothing otherwise', [/✉</.test(win.adminOrderEmailMarkerHtml(o({ email_sent_at: old }))), /✉⚠/.test(win.adminOrderEmailMarkerHtml(o())), win.adminOrderEmailMarkerHtml(o({ group_id: 'g4', ae_name: 'Nobody' }))], [true, true, '']);
  check('detail line: "sent <date>" with a Resend button; "not sent" with a Send button; nothing before the column exists', [/sent DT\(/.test(win.adminOrderEmailLineHtml(o({ email_sent_at: old }))) && /Resend order email/.test(win.adminOrderEmailLineHtml(o({ email_sent_at: old }))), /not sent/.test(win.adminOrderEmailLineHtml(o())) && /Send order email/.test(win.adminOrderEmailLineHtml(o())), (() => { const x = o(); delete x.email_sent_at; return win.adminOrderEmailLineHtml(x); })()], [true, true, '']);
  check('attention: an unsent email alone now counts (Trello fine); a sent one does not; Trello missing still counts; a team-copy-off group with nobody to email and Trello fine does not; under 10 minutes does not',
    [win.adminOrderNeedsAttention(o(), 90), win.adminOrderNeedsAttention(o({ email_sent_at: old }), 90), win.adminOrderNeedsAttention(o({ email_sent_at: old, trello_synced: false }), 90), win.adminOrderNeedsAttention(o({ group_id: 'g4', ae_name: 'Nobody' }), 90), win.adminOrderNeedsAttention(o({ created_at: fresh }), 90)], [true, false, true, false, false]);
  // resend: normal group
  win.eval(`document.body.innerHTML = '<div id="order-email-line"><button id="resend-email-btn"></button></div>'; allOrders = [${JSON.stringify(o())}]; __sent.length = 0; __db.length = 0; __toasts.length = 0; __sendStatus = 200;`);
  await win.adminResendOrderEmail('o1');
  const sent = win.eval('__sent.slice()'), db = win.eval('__db.slice()');
  check('resend: one email to the IO recipients + the AE (from the group roster); the team list is copied, minus anyone already in To', [sent.length, sent[0] && sent[0].to, sent[0] && sent[0].bcc], [1, 'ann@x.test,io1@x.test,io2@x.test', 'team1@x.test']);
  check('resend: the PDF is attached, and the time is recorded through the login-protected order function (only email_sent_at)', [sent[0] && sent[0].base64, db.filter(d => d.path === 'rpc/admin_set_order_trello_state').map(d => [d.body.p_name, d.body.p_order_id, Object.keys(d.body.p_data)])], ['AAAA', [['Carol', 'o1', ['email_sent_at']]]]);
  check('resend: the order now reads as sent and the AM is told', [win.eval('allOrders[0].email_sent_at') !== null, win.eval('__toasts.some(t => /Order email sent/.test(t))')], [true, true]);
  // resend: team copy off
  win.eval(`document.body.innerHTML = '<div id="order-email-line"><button id="resend-email-btn"></button></div>'; allOrders = [${JSON.stringify(o({ group_id: 'g3', ae_name: 'Nobody Known' }))}]; __sent.length = 0; __db.length = 0; __toasts.length = 0;`);
  await win.adminResendOrderEmail('o1');
  check('resend for a "don\'t copy the team" group: the team list is NOT copied (an AE not on the roster is simply not added)', [win.eval('__sent[0].to'), win.eval('__sent[0].bcc')], ['io3@x.test', '']);
  // resend: mail service down
  win.eval(`document.body.innerHTML = '<div id="order-email-line"><button id="resend-email-btn"></button></div>'; allOrders = [${JSON.stringify(o())}]; __sent.length = 0; __db.length = 0; __toasts.length = 0; __sendStatus = 500;`);
  await win.adminResendOrderEmail('o1');
  check('resend when the mail service is down: nothing is recorded, the AM is told it failed', [win.eval('__db.filter(d => d.path === "rpc/admin_set_order_trello_state").length'), win.eval('allOrders[0].email_sent_at'), win.eval('__toasts.some(t => /could not be sent/.test(t))')], [0, null, true]);
  // resend: PDF cannot be built -> still sends, says so
  win.eval(`document.body.innerHTML = '<div id="order-email-line"><button id="resend-email-btn"></button></div>'; allOrders = [${JSON.stringify(o())}]; __sent.length = 0; __db.length = 0; __toasts.length = 0; __sendStatus = 200; __pdfOk = false;`);
  await win.adminResendOrderEmail('o1');
  check('resend when the PDF cannot be built: the email still goes (without the PDF) and is recorded', [win.eval('__sent.length'), win.eval("'base64' in __sent[0]"), win.eval('__db.filter(d => d.path === "rpc/admin_set_order_trello_state").length')], [1, false, 1]);
  // a group with no IO recipients: no button is offered; if the function is called anyway it mirrors the order form (nobody in To -> the always-BCC list becomes To)
  check('a group with nobody to email: the detail line says so and offers no button; a group with no IO recipients but a team list still offers Send', [/nobody to email/.test(win.adminOrderEmailLineHtml(o({ group_id: 'g4', ae_name: 'Nobody' }))), /resend-email-btn/.test(win.adminOrderEmailLineHtml(o({ group_id: 'g4', ae_name: 'Nobody' }))), /Send order email/.test(win.adminOrderEmailLineHtml(o({ group_id: 'g2' })))], [true, false, true]);
  win.eval(`document.body.innerHTML = '<div id="order-email-line"><button id="resend-email-btn"></button></div>'; allOrders = [${JSON.stringify(o({ group_id: 'g2' }))}]; __sent.length = 0; __toasts.length = 0; __sendStatus = 200; __pdfOk = true;`);
  await win.adminResendOrderEmail('o1');
  check('...and called anyway it does what the order form does: with nobody else to email, the always-BCC list becomes the To', [win.eval('__sent.length'), win.eval('__sent[0].to'), win.eval('__sent[0].bcc')], [1, 'team1@x.test,io1@x.test', '']);
  check('the Orders tab shows the marker and the filter label says Trello or email', [/\$\{synced\}\$\{adminOrderEmailMarkerHtml\(o\)\}/.test(admin), /Trello or email needs attention/.test(admin)], [true, true]);
  win.eval(`document.body.innerHTML = '<div id="order-email-line"><button id="resend-email-btn"></button></div>'; allOrders = [${JSON.stringify(o({ group_id: 'g2', ae_name: 'Bob AE' }))}]; __sent.length = 0; __toasts.length = 0; __sendStatus = 200; __pdfOk = true;`);
  await win.adminResendOrderEmail('o1');
  check('a group with NO IO recipients: Resend goes to the AE (To) and copies the team list, like the original', [win.eval('__sent[0].to'), win.eval('__sent[0].bcc')], ['bob@x.test', 'team1@x.test,io1@x.test']);
  done();
})();
